/* USER CODE BEGIN addons */
&scmi_regu {
	scmi_vddio1: regulator@0 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
	};
	scmi_vddcore: regulator@11  {
		reg = <VOLTD_SCMI_STPMIC2_BUCK2>;
		regulator-name = "vddcore";
	};
	scmi_v1v8: regulator@14  {
		reg = <VOLTD_SCMI_STPMIC2_BUCK5>;
		regulator-name = "v1v8";
	};
	scmi_v3v3: regulator@16 {
		reg = <VOLTD_SCMI_STPMIC2_BUCK7>;
		regulator-name = "v3v3";
	};
	scmi_vdd_emmc: regulator@18 {
		reg = <VOLTD_SCMI_STPMIC2_LDO2>;
		regulator-name = "vdd_emmc";
	};
	scmi_vdd3v3_usb: regulator@20 {
		reg = <VOLTD_SCMI_STPMIC2_LDO4>;
		regulator-name = "vdd3v3_usb";
	};
	scmi_vdd_sdcard: regulator@23 {
		reg = <VOLTD_SCMI_STPMIC2_LDO7>;
		regulator-name = "vdd_sdcard";
	};
};

&switch0 {
	status = "okay";
	pinctrl-0 = <&eth1_rgmii_pins_mx>, <&eth3_rgmii_pins_a>;
	pinctrl-1 = <&eth1_rgmii_sleep_pins_mx>, <&eth3_rgmii_sleep_pins_a>;
	pinctrl-names = "default", "sleep";
	phy-mode = "rgmii";
	st,ethsw-internal-125;
};

&hpdma {
	memory-region = <&hpdma1_lli>;
};

&hpdma2 {
	memory-region = <&hpdma2_lli>;
};

&hpdma3 {
	memory-region = <&hpdma3_lli>;
};

&dsi_in {
	remote-endpoint = <&ltdc_ep0_out>;
};

&dsi_out {
	remote-endpoint = <&dsi_panel_in>;
};

&pcie_ep {
	pinctrl-names = "default", "init";
	pinctrl-0 = <&pcie_pins_mx>;
	pinctrl-1 = <&pcie_init_pins_mx>;
	reset-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
	status = "disabled";
};

&m0_rproc {
	memory-region = <&cm0_cube_fw>, <&cm0_cube_data>;
	clocks = <&rcc CK_CPU3>,
		 <&rcc CK_CPU3_AM>,
		 <&rcc CK_LPUART1_C3>,
		 <&rcc CK_KER_LPUART1>,
		 <&rcc CK_LPUART1_AM>,
		 <&rcc CK_GPIOZ_C3>,
		 <&scmi_clk CK_SCMI_GPIOZ>,
		 <&scmi_clk CK_SCMI_GPIOZ_AM>,
		 <&rcc CK_LPTIM4_C3>,
		 <&rcc CK_KER_LPTIM4>,
		 <&rcc CK_LPTIM4_AM>,
		 <&scmi_clk CK_SCMI_IPCC2>,
		 <&scmi_clk CK_SCMI_IPCC2_AM>;
	status = "disabled";
};

&ahbsr {
	mbox_client: mailbox-client@1 {
		compatible = "mbox-cdev";
		reg = <1 0>;
		memory-region =  <&ipc_shmem_2>;
		mboxes = <&ipcc2 0>;
		mbox-names = "rx-tx";
		status = "okay";
	};
};

&mlahb {
	intc_rpmsg: interrupt-controller@1 {
		compatible = "rpmsg,intc";
		reg = <1 0>;
		#interrupt-cells = <1>;
		interrupt-controller;
		status = "okay";
	};

	i2c_rpmsg: i2c@2 {
		compatible = "rpmsg,i2c-controller";
		reg = <2 0>;
		rpmsg,dev-id = "rpmsg_i2c";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		typec@35 {
			compatible = "st,stm32mp25-typec";
			reg = <0x35>;
			interrupts-extended = <&intc_rpmsg 0>;
			status = "okay";
			connector {
				compatible = "usb-c-connector";
				label = "USB-C";

				port {
					typec_ep: endpoint {
						//remote-endpoint = <&dwc3_ep>;
					};
				};
			};
		};
	};
};

&sai1 {
	clocks = <&rcc CK_BUS_SAI1>;
	clock-names = "pclk";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sai1a_pins_mx>, <&sai1b_pins_mx>;
	pinctrl-1 = <&sai1a_sleep_pins_mx>, <&sai1b_sleep_pins_mx>;
	status = "okay";

	sai1a: audio-controller@40290004 {
		dma-names = "rx";
		clocks = <&rcc CK_KER_SAI1>, <&sai1b>;
		clock-names = "sai_ck", "MCLK";
		dmas = <&hpdma 73 0x43 0x12>;
		st,sync = <&sai1b 2>;
		status = "okay";

		sai1a_port: port {
			sai1a_endpoint: endpoint {
				remote-endpoint = <&es8388_rx_endpoint>;
				dai-format = "i2s";
				mclk-fs = <256>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
			};
		};
 	};

	sai1b: audio-controller@40290024 {
		#clock-cells = <0>;
		dma-names = "tx";
		clock-names = "sai_ck";
		dmas = <&hpdma 74 0x43 0x21>;
		status = "okay";

		sai1b_port: port {
			sai1b_endpoint: endpoint {
				remote-endpoint = <&es8388_tx_endpoint>;
				dai-format = "i2s";
				mclk-fs = <256>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
 			};
 		};		
	};
};
/* USER CODE END addons */

