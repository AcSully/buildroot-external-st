	/* USER CODE BEGIN usb3dr */
	dwc3: usb@48300000 {
		maximum-speed = "high-speed";
        	usb-role-switch;

		port {
			usbotg_hs_ep: endpoint {
				remote-endpoint = <&con_usbotg_hs_ep>;
			};
		};
	};
	/* USER CODE END usb3dr */
};

